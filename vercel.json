{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/r/:code", "destination": "/api/index.js" },
    { "source": "/products", "destination": "/product.html" },
    { "source": "/shop", "destination": "/product.html" },
    { "source": "/reels", "destination": "/reels.html" },
    { "source": "/delivery", "destination": "/contact.html" },
    { "source": "/payment", "destination": "/contact.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/promises", "destination": "/testimonial.html" },
    { "source": "/style", "destination": "/blog_list.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reels/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
