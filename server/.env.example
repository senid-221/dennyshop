# Denny Shop dashboard + API settings
# Copy this file to server/.env and fill every value in. The server refuses to
# create an account while these still look like samples.

# Neon Postgres. Use the DIRECT endpoint to create the database the first time,
# then paste the POOLED endpoint here for the app.
DATABASE_URL=

# The one owner account. It is created by: npm run owner
# Password must be at least 10 characters and not a known sample value.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Used for advertiser links, which look like https://your-domain/r/CODE
PUBLIC_URL=

# Node port. Render sets this for you.
PORT=3000

# Leave unset (or 0) in production so session cookies are Secure.
# Set to 1 only while testing on http://localhost.
INSECURE_COOKIES=0
