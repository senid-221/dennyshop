# Denny Shop dashboard + API settings.
# Copy this file to server/.env (same folder) and fill the values in.

# Neon Postgres connection string. Use the POOLED endpoint for the app,
# and the DIRECT endpoint when you create the database the first time.
DATABASE_URL=postgres://ROLE:PASSWORD@ENDPOINT/dennyshop?sslmode=require

# First owner account. Run: npm run migrate && npm run seed && npm run owner
# You can change the password later from the dashboard under Team.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please-12
OWNER_NAME=Shop owner

# Used when building advertiser links (?ref=CODE)
PUBLIC_URL=http://127.0.0.1:3000

# Node port. Render sets this for you.
PORT=3000

# Set to 1 only while testing on http://localhost (cookies without the Secure flag).
INSECURE_COOKIES=1
