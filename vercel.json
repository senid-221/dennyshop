{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "server/**"
    },
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/buy",
      "destination": "/buy.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/products",
      "destination": "/product.html"
    },
    {
      "source": "/shop",
      "destination": "/product.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/reel",
      "destination": "/reels.html"
    },
    {
      "source": "/reels",
      "destination": "/reels.html"
    },
    {
      "source": "/payment",
      "destination": "/contact.html"
    },
    {
      "source": "/proof",
      "destination": "/contact.html"
    },
    {
      "source": "/delivery",
      "destination": "/contact.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/promises",
      "destination": "/testimonial.html"
    },
    {
      "source": "/style",
      "destination": "/blog_list.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reels/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
